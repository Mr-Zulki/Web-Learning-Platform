# Environment variables for full Docker Compose stack (docker-compose.yml)
# Copy this file to .env.docker and adjust values as needed.
# Real .env.docker is strictly gitignored.

# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_prod_password
POSTGRES_DB=uni_dev

# Internal database connection URL pointing to the private `db` container
DATABASE_URL=postgresql://postgres:postgres_prod_password@db:5432/uni_dev?schema=public

# Shared Auth.js secret key (CRITICAL: must be identical across all app replicas for JWT sessions)
# Generate with: npx auth secret or openssl rand -base64 32
AUTH_SECRET=replaceme_super_secret_key_at_least_32_characters_long_for_jwt_session

# Auth.js reverse proxy configuration
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:8080
NODE_ENV=production

