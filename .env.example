# Database Credentials
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_password"
POSTGRES_DB="uni_dev"

# Database Connection URLs
# For Neon pooled connections (-pooler host), add ?pgbouncer=true so Prisma
# uses the simple protocol instead of prepared statements through PgBouncer.
DATABASE_URL="postgresql://postgres:postgres_dev_password@127.0.0.1:5432/uni_dev?schema=public"
# Direct URL used for Prisma migrations and direct database access (e.g., Neon unpooled)
DIRECT_URL="postgresql://postgres:postgres_dev_password@127.0.0.1:5432/uni_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres_dev_password@127.0.0.1:5432/uni_test?schema=public"

# Auth.js / NextAuth
# Generate a secure secret using: npx auth secret  OR  openssl rand -base64 32
AUTH_SECRET="insecure-placeholder-dev-auth-secret-min-32-chars-long"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate limiting profile: "strict" (default) or "demo" for load tests
RATE_LIMIT_PROFILE=strict
